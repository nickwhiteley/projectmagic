# Copy to .env (gitignored) and fill in. spec.md §11.3 says where each value comes from.

# Neon Postgres, the pooled connection string.
DATABASE_URL=

# The GitHub App: its page shows the App ID and client ID; generate the secret and key there.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Either the private key's contents (on Vercel) or a path to the .pem (locally).
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
# openssl rand -hex 32; the same value goes in the App's webhook settings.
GITHUB_WEBHOOK_SECRET=

# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# The App's URL name: github.com/apps/<slug>. Needed for "Connect GitHub" on the tenant pages.
GITHUB_APP_SLUG=

# The first platform administrator, created on first sign-in.
BOOTSTRAP_ADMIN_GITHUB_LOGIN=nickwhiteley

# Inferred status (PM3). Leave INFERENCE_PROVIDER unset to turn it off.
# ollama (INFERENCE_BASE_URL, such as http://localhost:11434; or INFERENCE_API_KEY alone for Ollama cloud,
# https://ollama.com), openai or anthropic (INFERENCE_API_KEY).
INFERENCE_PROVIDER=
INFERENCE_MODEL=
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
# Tokens a project may use a day (default 50000).
INFERENCE_DAILY_TOKEN_LIMIT=

# Set by Vercel for the daily cron; locally, any value.
CRON_SECRET=
